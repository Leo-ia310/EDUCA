# Append to the backend/worker environment; never ship credentials to Flutter.
# Worker requires existing SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Run on a separate service/process, after applying reviewed migration 0058.
ORIGINALITY_MAX_BYTES=5242880
ORIGINALITY_MAX_PAGES=50
ORIGINALITY_MAX_WORDS=20000
ORIGINALITY_MIN_WORDS=40
ORIGINALITY_NGRAM=5
ORIGINALITY_EXTRACTION_MS=30000
ORIGINALITY_POLL_MS=5000
# Consumer concurrency is fixed at 1 and fenced globally in PostgreSQL.
