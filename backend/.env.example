# =============================================================================
# Educa360 — backend Node + credenciales Supabase
# Copia este archivo a `backend/.env` y complétalo. NO commitees `.env`.
# =============================================================================

NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Base pública del backend Node. El frontend llama:
#   ${BACKEND_API_BASE_URL}/business-api
BACKEND_API_BASE_URL=http://localhost:3000/api

# Ref del proyecto Supabase (parte del subdominio de la URL).
SUPABASE_PROJECT_REF=qwfkmijewogksfizdski

# URL pública del proyecto.
SUPABASE_URL=https://qwfkmijewogksfizdski.supabase.co

# Clave pública (anon). Se pasa al cliente Flutter. Respeta RLS.
SUPABASE_ANON_KEY=

# Clave secreta de servicio. Opcional para la API Node: las requests normales
# usan el JWT del usuario y respetan RLS. Si la configuras, sigue siendo SOLO
# backend/seed/admin. Ignora RLS. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Password de la base Postgres (para `supabase link` / `db push` / scripts).
SUPABASE_DB_PASSWORD=

# Conexión directa a Postgres vía pooler (la usan los scripts en backend/scripts).
# El host/región se ve en el panel: Settings → Database → Connection pooling.
SUPABASE_DB_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.qwfkmijewogksfizdski
SUPABASE_DB_NAME=postgres

# Web Push (Edge Function send-push). La pública también va al cliente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
