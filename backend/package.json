{
  "name": "educa360-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:originality": "node --max-old-space-size=160 dist/modules/assignments/originality/worker.js",
    "check:schemas": "node scripts/check_api_schemas.mjs",
    "docs:apis": "tsx scripts/generate-api-docs.ts && tsx scripts/generate-openapi.ts",
    "prebuild": "npm run docs:apis",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run docs:apis",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test:integration": "node --test --test-concurrency=1 test/*.integration.test.mjs",
    "test:unit": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "pdfjs-dist": "^6.4.299",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.20.0",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.13.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
